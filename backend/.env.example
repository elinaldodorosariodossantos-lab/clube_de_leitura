PORT=3001
# demo ou supabase. Produção exige supabase.
DATA_MODE=demo
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Em produção, informe a origem exata do frontend (sem barra final).
APP_ORIGIN=
# Máximo de cadastros por IP em 15 minutos. Login e retorno: 20 tentativas.
REGISTRATION_LIMIT=120
# Chave AES de 32 bytes (64 caracteres hexadecimais). Manter fixa e guardar em segredo.
ACCESS_CREDENTIALS_KEY=
# URL pública do frontend para fichas/QR. Obrigatória em produção (HTTPS).
PUBLIC_APP_URL=
